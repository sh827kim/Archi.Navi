{
  "name": "@archi-navi/core",
  "version": "0.1.0",
  "private": false,
  "description": "Core graph engine: query, rollup, and graph index for Archi.Navi",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test:unit": "vitest run src/__tests__",
    "test:unit:watch": "vitest src/__tests__",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@archi-navi/db": "workspace:*",
    "@archi-navi/shared": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "graphology": "^0.26.0",
    "graphology-shortest-path": "^2.1.0",
    "graphology-traversal": "^0.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
