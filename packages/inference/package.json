{
  "name": "@archi-navi/inference",
  "version": "0.1.0",
  "private": false,
  "description": "Inference engines: relation and domain inference for Archi.Navi",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "pnpm run download:wasm && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "dev": "tsc -w --preserveWatchOutput",
    "test:unit": "vitest run src/__tests__",
    "test:benchmark-gate": "vitest run src/__tests__/orchestration/intentProofBenchmarkGate.test.ts",
    "test:cutover-fixture": "vitest run src/__tests__/orchestration/inferenceCutoverFixture.test.ts",
    "test:unit:coverage": "vitest run src/__tests__ --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html --coverage.thresholds.lines=80 --coverage.thresholds.functions=80 --coverage.thresholds.branches=80 --coverage.thresholds.statements=80 --coverage.thresholds.perFile=true",
    "test:unit:watch": "vitest src/__tests__",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepack": "pnpm run download:wasm && pnpm run clean && pnpm run build",
    "download:wasm": "node scripts/download-wasm-grammars.mjs",
    "postinstall": "node scripts/download-wasm-grammars.mjs"
  },
  "files": [
    "dist",
    "wasm",
    "scripts/download-wasm-grammars.mjs"
  ],
  "dependencies": {
    "@archi-navi/core": "workspace:*",
    "@archi-navi/db": "workspace:*",
    "@archi-navi/shared": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "js-yaml": "^4.1.0",
    "web-tree-sitter": "^0.24.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  }
}
