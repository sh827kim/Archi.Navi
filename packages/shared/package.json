{
  "name": "@archi-navi/shared",
  "version": "0.1.0",
  "private": false,
  "description": "Shared types, constants, and utilities for Archi.Navi",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./constants": {
      "import": "./dist/constants/index.js",
      "require": "./dist/constants/index.js",
      "types": "./dist/constants/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "uuid": "^13.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
